# Copy this file to .env (or api/.env) and fill in real values.
# Never commit .env — it is gitignored.

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# OpenRouter (LLM narrative generation)
OPENROUTER_API_KEY=

# Qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333

# CVE corpus — path to cloned cvelistV5 repo
# Clone: git clone --depth=1 --filter=blob:none --sparse https://github.com/CVEProject/cvelistV5.git ~/data/cvelistV5
# Then: cd ~/data/cvelistV5 && git sparse-checkout set --cone cves/2024 (or all years)
CVELIST_DIR=

# STIX ATT&CK bundle — path to enterprise-attack.json
STIX_BUNDLE_PATH=
